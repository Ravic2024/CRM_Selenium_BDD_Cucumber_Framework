<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">test-output/logs</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%t] %c{1} - %msg%n%throwable</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <File name="FrameworkFile" fileName="${LOG_DIR}/framework.log" append="false">
            <PatternLayout pattern="${PATTERN}"/>
        </File>

        <File name="ErrorFile" fileName="${LOG_DIR}/errors.log" append="false" createOnDemand="true">
            <PatternLayout pattern="${PATTERN}"/>
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>

        <File name="FailedScenarioFile" fileName="${LOG_DIR}/failed-scenarios.log" append="false" createOnDemand="true">
            <PatternLayout pattern="%msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Logger name="FailedScenarioLogger" level="error" additivity="false">
            <AppenderRef ref="FailedScenarioFile"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.openqa.selenium" level="warn"/>
        <Logger name="io.netty" level="warn"/>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FrameworkFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>
